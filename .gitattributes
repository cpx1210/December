# Keep repository text files consistent with Biome and Unix-based deploy environments.
* text=auto eol=lf

# Windows command scripts require CRLF for broad compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.bin binary
*.pdf binary
*.zip binary
*.gz binary
*.br binary
